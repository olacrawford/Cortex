# Cortex 配置示例
# 复制为 config.yaml 并填入真实密钥：
#   cp .cortex/config.yaml.example .cortex/config.yaml
# 注意：config.yaml 已被 .gitignore 忽略，不会提交到仓库；本示例仅含占位密钥，可安全提交。

providers:
  - name: claude
    protocol: anthropic
    api_key: sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
    model: claude-sonnet-4-20250514
    thinking: true
    context_window: 200000   # 可选，单位 token；未配置时按 protocol 默认（anthropic 200000、openai 128000）

  # - name: deepseek
  #   protocol: openai-compat
  #   base_url: https://api.deepseek.com
  #   api_key: sk-ds-xxxxxxxxxxxxxxxxxxxxxxxx
  #   model: deepseek-chat

  # - name: gpt4
  #   protocol: openai
  #   api_key: sk-xxxxxxxxxxxxxxxxxxxxxxxx
  #   model: gpt-4o

# 字段说明：
#   name       供应商标识名（状态栏左侧显示）
#   protocol   anthropic | openai | openai-compat
#   base_url   可选；自定义端点（openai-compat 常用，如 DeepSeek）
#   api_key    认证密钥（必填，不回显）
#   model      模型名（状态栏右侧显示）
#   thinking   可选；仅 anthropic 生效（扩展思考）
#   context_window  可选；上下文窗口（token），未配置时按 protocol 默认
#
# ch09 记忆与会话持久化说明：
#   - 项目指令：<project_root>/MEWCODE.md、<project_root>/.cortex/MEWCODE.md、~/.cortex/MEWCODE.md
#     三层按此优先级合并（高优先级在前），支持 @include 引用其他文件。
#   - 会话存档：.cortex/sessions/<session_id>/conversation.jsonl（JSONL 追加写），
#     工具结果落盘在 .cortex/sessions/<session_id>/tool-results/。
#   - 自动笔记：.cortex/memory/（项目级）与 ~/.cortex/memory/（用户级），索引文件 MEMORY.md。
#   - 这些目录均由程序自动创建，无需手动配置。
